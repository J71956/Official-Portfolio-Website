{
  "routes": [
    {
      "route": "/static/*",
      "statusCode": 404
    },
    {
      "route": "/assets/img/*",
      "headers": { "Cache-Control": "public, max-age=31536000, immutable" }
    },
    {
      "route": "/assets/*",
      "headers": { "Cache-Control": "public, max-age=604800" }
    },
    {
      "route": "/index.html",
      "headers": { "Cache-Control": "public, max-age=300, must-revalidate" }
    }
  ],
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "Referrer-Policy": "strict-origin-when-cross-origin",
    "Content-Security-Policy": "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; base-uri 'none'; frame-ancestors 'none'"
  },
  "mimeTypes": {
    ".avif": "image/avif",
    ".webp": "image/webp",
    ".svg": "image/svg+xml",
    ".json": "application/json"
  },
  "responseOverrides": {
    "404": { "rewrite": "/index.html" }
  }
}
